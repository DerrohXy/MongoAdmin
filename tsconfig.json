{
    "compilerOptions": {
        "target": "es6",
        "lib": ["es2021"],
        "module": "preserve",
        "outDir": "./build",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "swiftssr"
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules"]
}
